#!/usr/bin/env bash
# llm-sessions — read-only status of open terminals on a named box.
# Usage: llm-sessions [connection]        (default: ACTIVE from config)
# Engine-aware: engine=screen -> GNU Screen sessions; engine=herdr -> Herdr panes/tabs.
# Only read-only commands run on the remote side.
# Params resolved via llm-config-get (single source of truth).

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GET="$SELF_DIR/llm-config-get"

getout="$(bash "$GET" 2>/dev/null)"
name="${1:-$(printf '%s\n' "$getout" | sed -n 's/^ACTIVE=//p')}"
[ -z "$name" ] && name="LLM"

entry=$(printf '%s\n' "$getout" | sed -n "s/^CONN_${name}=//p")
if [ -z "$entry" ]; then
  echo "unknown connection '$name' — see llm-config-get" >&2
  exit 3
fi
HOST="${entry%%|*}"; rem="${entry#*|}"; USER="${rem%%|*}"; rem="${rem#*|}"; PORT="${rem%%|*}"; rem="${rem#*|}"; MODE="${rem%%|*}"; ENGINE="${rem#*|}"
[ -z "$ENGINE" ] && ENGINE="screen"

TARGET="${USER}@${HOST}"
SSHOPT=(-p "$PORT")
TIMEOUT=12

# Format two /proc/stat samples and MemTotal/MemAvailable from the target.
# MemAvailable excludes reclaimable cache from the displayed RAM usage.
format_metrics() {
  printf '%s\n' "$1" | sed -n '/__METRICS__/,/__END__/p' | LC_ALL=C awk '
    $1 == "cpu" {
      total = 0
      for (i = 2; i <= 9; i++) total += $i
      idle = $5 + $6
      if (++samples == 1) { first_total = total; first_idle = idle }
      else if (samples == 2) { delta = total - first_total; busy = delta - (idle - first_idle) }
    }
    $1 == "MemTotal:" { mem_total = $2 }
    $1 == "MemAvailable:" { mem_available = $2; has_available = 1 }
    END {
      if (samples == 2 && delta > 0) {
        cpu = int(100 * busy / delta + 0.5)
        if (cpu < 0) cpu = 0
        if (cpu > 100) cpu = 100
        printf "CPU %d%%", cpu
      } else printf "CPU unavailable"
      if (mem_total > 0 && has_available) {
        used = mem_total - mem_available
        if (used < 0) used = 0
        if (mem_total >= 1048576)
          printf " · RAM %.1f / %.1f GB", used / 1048576, mem_total / 1048576
        else
          printf " · RAM %.0f / %.0f MB", used / 1024, mem_total / 1024
      } else printf " · RAM unavailable"
      printf "\n"
    }
  '
}

# ============================ engine: herdr ============================
if [ "$ENGINE" = "herdr" ]; then
  LOCAL=""
  [ "$HOST" = "local" ] && LOCAL=1
  DISPHOST="$HOST"
  [ -n "$LOCAL" ] && DISPHOST="this PC"

  if [ -n "$LOCAL" ]; then
    # Herdr server on this PC: talk to its local socket directly, no SSH
    remote=$(timeout "$TIMEOUT" /bin/sh -c '
      export PATH="$HOME/.local/bin:$PATH"
      echo "__HERDR__"
      herdr pane list 2>/dev/null || exit 1
      echo "__TABS__"
      herdr tab list 2>/dev/null || exit 1
      echo "__WORKSPACES__"
      herdr workspace list 2>/dev/null || exit 1
      echo "__USERS__"
      echo "__UPTIME__"
      uptime
      echo "__METRICS__"
      head -n 1 /proc/stat
      sleep 0.2
      head -n 1 /proc/stat
      grep -E "^MemTotal:|^MemAvailable:" /proc/meminfo
      echo "__END__"
    ' 2>/dev/null)
    rc=$?
  else
    remote=$(timeout "$TIMEOUT" ssh "${SSHOPT[@]}" -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR \
      "$TARGET" '
        export PATH="$HOME/.local/bin:$PATH"
        echo "__HERDR__"
        herdr pane list 2>/dev/null || exit 1
        echo "__TABS__"
        herdr tab list 2>/dev/null || exit 1
        echo "__WORKSPACES__"
        herdr workspace list 2>/dev/null || exit 1
        echo "__USERS__"
        w -h
        echo "__UPTIME__"
        uptime
        echo "__METRICS__"
        head -n 1 /proc/stat
        sleep 0.2
        head -n 1 /proc/stat
        grep -E "^MemTotal:|^MemAvailable:" /proc/meminfo
        echo "__END__"
      ' 2>/dev/null)
    rc=$?
  fi
  if [ "$rc" -ne 0 ] || [ -z "$remote" ]; then
    echo "OFFLINE — ${name} (${DISPHOST}) unreachable or Herdr not responding"
    exit 1
  fi

  panes_json=$(printf '%s\n' "$remote" | sed -n '/__HERDR__/,/__TABS__/p' | sed '1d;$d')
  tabs_json=$(printf '%s\n' "$remote" | sed -n '/__TABS__/,/__WORKSPACES__/p' | sed '1d;$d')
  ws_json=$(printf '%s\n' "$remote" | sed -n '/__WORKSPACES__/,/__USERS__/p' | sed '1d;$d')

  nusers=$(printf '%s\n' "$remote" | sed -n '/__USERS__/,/__UPTIME__/p' | grep -c 'pts/')
  up=$(printf '%s\n' "$remote" | sed -n '/__UPTIME__/,$p' | grep -v '__' | head -1)
  upt=$(printf '%s\n' "$up" | sed -E 's/.*up ([^,]*),.*/\1/; s/ //g')
  metrics=$(format_metrics "$remote")

  block=$(python3 - "$panes_json" "$tabs_json" "$ws_json" <<'EOF'
import json, sys

raws = sys.argv[1:4]
if not (any(j.strip() for j in raws)):
    print("Herdr: (server not responding)")
    sys.exit(0)

def load(j):
    try:
        return (json.loads(j).get("result") or {})
    except Exception:
        return {}

P = load(raws[0]); T = load(raws[1]); W = load(raws[2])
panes = P.get("panes") or []
tabs = T.get("tabs") or []
ws = W.get("workspaces") or []

npanes = len(panes); ntabs = len(tabs); nws = len(ws)
def pl(n): return "" if n == 1 else "s"
print("Herdr: %d pane%s \u00b7 %d tab%s \u00b7 %d workspace%s" \
      % (npanes, pl(npanes), ntabs, pl(ntabs), nws, pl(nws)))
labels = {}
for w in ws:
    if w.get("workspace_id"):
        labels[w["workspace_id"]] = w.get("label") or ""
for p in panes:
    pid = p.get("pane_id") or "?"
    cwd = (p.get("cwd") or "").strip()
    wslabel = labels.get(p.get("workspace_id") or "", "")
    rest = ""
    if cwd:
        rest += cwd
    if wslabel:
        rest += ("  \u00b7  " if rest else "") + "ws " + wslabel
    print("    %s  [Running]  %s" % (pid, rest))
EOF
)

  [ -z "$block" ] && block="Herdr: (no data)"

  echo "${name} (${DISPHOST}) · up ${upt} · ${metrics}"
  echo
  printf '%s\n' "$block"
  echo
  [ -z "$LOCAL" ] && echo "SSH terminals: ${nusers}"
  exit 0
fi

# ============================ engine: screen (GNU Screen) ============================
remote=$(timeout "$TIMEOUT" ssh "${SSHOPT[@]}" -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR \
  "$TARGET" '
    echo "__SCREENS__"
    screen -ls 2>/dev/null
    echo "__USERS__"
    w -h
    echo "__UPTIME__"
    uptime
    echo "__PROCS__"
    ps -eo comm | grep -c "^[l]lama-server" || true
    ps -eo comm | grep -c "^[n]8n" || true
    ps -eo comm | grep -c "^[o]llama" || true
    echo "__METRICS__"
    head -n 1 /proc/stat
    sleep 0.2
    head -n 1 /proc/stat
    grep -E "^MemTotal:|^MemAvailable:" /proc/meminfo
    echo "__END__"
' 2>/dev/null)

if [ -z "$remote" ]; then
  echo "OFFLINE — ${name} (${HOST}) unreachable"
  exit 1
fi

# --- parse screen sessions ---
screens=$(printf '%s\n' "$remote" | sed -n '/__SCREENS__/,/__USERS__/p' | grep -E '^[[:space:]]*[0-9]+\.[^[:space:]]+')
attached=0; detached=0; slist=""
if [ -n "$screens" ]; then
  attached=$(printf '%s\n' "$screens" | grep -c -i 'Attached')
  detached=$(printf '%s\n' "$screens" | grep -c -i 'Detached')
  slist=$(printf '%s\n' "$screens" | sed -E 's/^[[:space:]]*//; s/[[:space:]]*\(([A-Za-z]+)\)/  [\1]/' )
fi
total=$((attached+detached))

# --- users / pts ---
nusers=$(printf '%s\n' "$remote" | sed -n '/__USERS__/,/__UPTIME__/p' | grep -c 'pts/')
pts=$(printf '%s\n' "$remote" | sed -n '/__USERS__/,/__UPTIME__/p' | grep -o 'pts/[0-9]*' | sort -u | tr '\n' ' ')

# --- uptime / load ---
up=$(printf '%s\n' "$remote" | sed -n '/__UPTIME__/,$p' | grep -v '__' | head -1)
upt=$(printf '%s\n' "$up" | sed -E 's/.*up ([^,]*),.*/\1/; s/ //g')
metrics=$(format_metrics "$remote")

# --- proc counts ---
procs=$(printf '%s\n' "$remote" | sed -n '/__PROCS__/,/__END__/p' | grep -v '__')
p_llama=$(printf '%s\n' "$procs" | sed -n '1p')
p_n8n=$(  printf '%s\n' "$procs" | sed -n '2p')
p_ollama=$(printf '%s\n' "$procs" | sed -n '3p')

# --- output (human readable for popup / CLI) ---
echo "${name} (${HOST}) · up ${upt} · ${metrics}"
echo
if [ "$total" -gt 0 ]; then
  echo "Screen: ${total} open — ${attached} attached · ${detached} detached"
  printf '%s\n' "$slist" | sed 's/^/   /'
else
  echo "Screen: none open"
fi
echo
echo "SSH terminals: ${nusers} (pts: ${pts})"
echo "llama-server: ${p_llama}   n8n: ${p_n8n}   ollama: ${p_ollama}"
